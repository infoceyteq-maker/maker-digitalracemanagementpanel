# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Public URL of the deployed application
APP_URL="https://digitalrace.ceyteq.linkpc.net"

# NEXTAUTH / JWT CONFIGURATION
NEXTAUTH_URL="https://digitalrace.ceyteq.linkpc.net"
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-secret-here"
JWT_SECRET="generate-a-secure-32-byte-hex-secret-here"

# DATABASE CONNECTION (Supabase / Neon PostgreSQL)
# Pooled connection string (Port 6543 for PgBouncer / Serverless runtime)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct connection string for migrations/DDL (Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# SUPABASE CLIENT
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# DISTRIBUTED RATE LIMITING (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token-here"

# EMAIL & OTP SERVICE (Resend)
RESEND_API_KEY="re_123456789abcdef"
EMAIL_FROM="noreply@ceyteq.linkpc.net"

# WHATSAPP CLOUD API (Meta Graph API)
WHATSAPP_CLOUD_API_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="ceyteq_secure_verify_token_2026"
