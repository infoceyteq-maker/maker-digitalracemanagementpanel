# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key-here"

# APP_URL: Public URL of the deployed application
APP_URL="https://dashboard.ceyteq.com"

# NEXTAUTH / JWT CONFIGURATION
NEXTAUTH_URL="https://dashboard.ceyteq.com"
NEXTAUTH_SECRET="generate-a-secure-32-byte-hex-secret-here"
JWT_SECRET="generate-a-secure-32-byte-hex-secret-here"

# DATABASE CONNECTION (PostgreSQL / Supabase / Neon)
# Pooled connection string (Port 6543 for PgBouncer / Neon connection pooling)
DATABASE_URL="postgresql://user:password@pooler.neon.tech/ceyteq_db?sslmode=require&pgbouncer=true"
# Direct connection string for migrations/DDL (Port 5432)
DIRECT_URL="postgresql://user:password@ep-direct.neon.tech/ceyteq_db?sslmode=require"

# DISTRIBUTED RATE LIMITING (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token-here"

# EMAIL & OTP SERVICE (Resend or SendGrid)
RESEND_API_KEY="re_123456789abcdef"
EMAIL_FROM="security@ceyteq.com"

# WHATSAPP CLOUD API (Meta Graph API)
WHATSAPP_CLOUD_API_TOKEN="EAA..."
WHATSAPP_PHONE_NUMBER_ID="10987654321"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="ceyteq_secure_verify_token_2026"
