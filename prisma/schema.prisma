// ==============================================================================
// CEYTEQ ENTERPRISE ECOSYSTEM - PRISMA SCHEMA DEFINITION
// Platforms: Digital Race & TasteTrip Multi-Tenant Architecture
// Target Database: PostgreSQL 15+ (Supabase Cloud / Neon / AWS Aurora)
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ------------------------------------------------------------------------------
// ENUMS
// ------------------------------------------------------------------------------

enum UserRole {
  SUPER_MASTER_ADMIN
  DIGITAL_RACE_MASTER
  TASTETRIP_MASTER
  DIVISION_ADMIN
  RESTAURANT_ADMIN
  RESTAURANT_STAFF
  DELIVERY_DRIVER
}

enum PlatformBranch {
  DIGITAL_RACE
  TASTETRIP
  ALL
}

enum DivisionId {
  UP_COUNTRY
  SOUTH
  WESTERN
  NORTH
}

enum SriLankanProvince {
  CENTRAL
  UVA
  SABARAGAMUWA
  SOUTHERN
  EASTERN
  WESTERN
  NORTH_WESTERN
  NORTHERN
  NORTH_CENTRAL
}

enum SubscriptionTier {
  FREE
  PRO
  PLUS
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

// ------------------------------------------------------------------------------
// TENANTS (RESTAURANTS / STORES)
// ------------------------------------------------------------------------------

model Tenant {
  id                   String            @id @default(uuid()) @db.Uuid
  name                 String            @db.VarChar(255)
  slug                 String            @unique @db.VarChar(100)
  subdomain            String            @unique @db.VarChar(100)
  branch               PlatformBranch    @default(DIGITAL_RACE)
  divisionId           DivisionId        @default(WESTERN)
  province             SriLankanProvince @default(WESTERN)
  city                 String            @default("Colombo") @db.VarChar(100)
  address              String            @db.Text
  
  // Subscription & Capabilities
  subscriptionTier     SubscriptionTier  @default(PRO)
  monthlyFee           Decimal           @default(129.00) @db.Decimal(10, 2)
  status               AccountStatus     @default(ACTIVE)
  
  // Add-On Modules
  hasAiChatbot         Boolean           @default(false)
  hasWhatsAppBot       Boolean           @default(false)
  whatsAppPhoneNumberId String?          @db.VarChar(100)
  whatsAppWebhookToken String?           @db.VarChar(255)
  
  // Operational Details
  currency             String            @default("LKR") @db.VarChar(10)
  tableCount           Int               @default(15)
  accentColor          String            @default("#00C8FF") @db.VarChar(50)
  logoUrl              String?           @db.Text
  coverImageUrl        String?           @db.Text
  deliveryEnabled      Boolean           @default(true)
  paymentGatewayEnabled Boolean          @default(true)

  // Relationships
  users                User[]
  activationTokens     ActivationToken[]
  division             Division          @relation(fields: [divisionId], references: [id])

  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)

  @@index([slug])
  @@index([branch, divisionId])
  @@index([province])
  @@map("tenants")
}

// ------------------------------------------------------------------------------
// GEOGRAPHIC REGIONS (DIVISIONS)
// ------------------------------------------------------------------------------

model Division {
  id                 DivisionId          @id
  name               String              @db.VarChar(100)
  platformBranch     PlatformBranch      @default(ALL)
  provinces          SriLankanProvince[]
  regionalLeadEmail  String?             @db.VarChar(255)
  regionalOfficeCity String?             @db.VarChar(100)

  // Relationships
  tenants            Tenant[]
  users              User[]

  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  @@map("divisions")
}

// ------------------------------------------------------------------------------
// USERS & PRINCIPALS
// ------------------------------------------------------------------------------

model User {
  id                   String              @id @default(uuid()) @db.Uuid
  email                String              @unique @db.VarChar(255)
  phone                String              @unique @db.VarChar(50)
  name                 String              @db.VarChar(255)
  passwordHash         String              @db.Text
  role                 UserRole            @default(RESTAURANT_ADMIN)
  branch               PlatformBranch      @default(DIGITAL_RACE)
  divisionId           DivisionId?
  allowedProvinces     SriLankanProvince[]
  tenantId             String?             @db.Uuid
  status               AccountStatus       @default(PENDING_ACTIVATION)

  // Security Flags
  isEmailVerified      Boolean             @default(false)
  isPhoneVerified      Boolean             @default(false)
  mfaEnabled           Boolean             @default(false)
  mfaSecret            String?             @db.Text
  failedLoginAttempts  Int                 @default(0)
  lockedUntil          DateTime?           @db.Timestamptz(6)
  lastLoginAt          DateTime?           @db.Timestamptz(6)

  // Relationships
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  division             Division?           @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  activationTokens     ActivationToken[]
  otpVerifications     OtpVerification[]

  createdAt            DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(6)

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([branch, divisionId])
  @@index([tenantId])
  @@map("users")
}

// ------------------------------------------------------------------------------
// FIRST-TIME ACCOUNT ACTIVATION TOKENS
// Single-use, cryptographically signed SHA-256 tokens with 48-hour TTL
// ------------------------------------------------------------------------------

model ActivationToken {
  id                   String              @id @default(uuid()) @db.Uuid
  tokenHash            String              @unique @db.Text
  userId               String              @db.Uuid
  email                String              @db.VarChar(255)
  role                 UserRole
  branch               PlatformBranch      @default(DIGITAL_RACE)
  divisionId           DivisionId?
  allowedProvinces     SriLankanProvince[]
  tenantId             String?             @db.Uuid
  used                 Boolean             @default(false)
  expiresAt            DateTime            @db.Timestamptz(6)
  usedAt               DateTime?           @db.Timestamptz(6)

  // Relationships
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant               Tenant?             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt            DateTime            @default(now()) @db.Timestamptz(6)

  @@index([tokenHash])
  @@index([userId, used])
  @@index([email])
  @@map("activation_tokens")
}

// ------------------------------------------------------------------------------
// DUAL-CHANNEL OTP VERIFICATIONS (EMAIL + WHATSAPP)
// ------------------------------------------------------------------------------

model OtpVerification {
  id                   String              @id @default(uuid()) @db.Uuid
  userId               String?             @db.Uuid
  identifier           String              @db.VarChar(255) // email or phone
  emailOtpHash         String              @db.Text
  phoneOtpHash         String              @db.Text
  attempts             Int                 @default(0)
  maxAttempts          Int                 @default(3)
  verified             Boolean             @default(false)
  expiresAt            DateTime            @db.Timestamptz(6)
  consumedAt           DateTime?           @db.Timestamptz(6)

  // Relationships
  user                 User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt            DateTime            @default(now()) @db.Timestamptz(6)

  @@index([identifier, verified])
  @@index([userId])
  @@map("otp_verifications")
}
